# Application Settings
APP_NAME="Bulk Certificate Generator API"
APP_ENV="development"
DEBUG=true

# Database Configuration (SQLite default, PostgreSQL compatible)
# SQLite:
DATABASE_URL=sqlite:///./certificates.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certificates_db

# File Storage Directory
GENERATED_CERTIFICATES_DIR=generated_certificates

# Bulk limits
MAX_BULK_LIMIT=1000
